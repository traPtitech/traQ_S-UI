{
	admin off
}

:80

encode zstd gzip
header /sw.js Cache-Control "max-age=0"

root * /usr/share/caddy

@spa not path /assets /assets/*
@html path / /index.html

route {
	route @spa {
		try_files {path} /index.html
	}

	header @html Cache-Control "no-cache"

	file_server {
		precompressed br gzip
	}
}
