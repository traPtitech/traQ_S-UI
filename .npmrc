allow-git=none
audit=true
audit-level=high
engine-strict=true
ignore-scripts=true
min-release-age=7
# Temporary: remove once qs meets min-release-age.
min-release-age-exclude[]=qs
# Published and maintained with traQ's Markdown engine.
min-release-age-exclude[]=@traq-markdown-engine/*
save-exact=true
strict-peer-deps=true
